{
    "name": "server",
    "version": "1.0.0",
    "description": "Express/Mongoose backend for the Alpinfex tour dashboard: GPX parsing, tour records and photo storage.",
    "main": "server.js",
    "scripts": {
        "test": "cross-env NODE_ENV=testing MONGO_URL=mongodb://localhost:27017/TestTours LOGGER=false mocha ./tests --recursive --timeout 20000 --exit",
        "dev": "cross-env NODE_ENV=development MONGO_URL=mongodb://localhost:27017/DevTours nodemon server.js",
        "start": "cross-env NODE_ENV=production MONGO_URL=mongodb://localhost:27017/ProdTours LOGGER=false node server.js"
    },
    "type": "module",
    "author": "Phillip Kofler <koflerphillip@outlook.com>",
    "license": "MIT",
    "dependencies": {
        "@we-gold/gpxjs": "^1.2.0",
        "assert": "^2.1.0",
        "cors": "^2.8.6",
        "cross-env": "^7.0.3",
        "dotenv": "^16.6.1",
        "express": "^4.22.2",
        "mongoose": "^8.24.3",
        "multer": "^1.4.5-lts.1",
        "node-cache": "^5.1.2",
        "sharp": "^0.35.3",
        "winston": "^3.19.0",
        "xml2js": "^0.6.2"
    },
    "devDependencies": {
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.0",
        "@types/mocha": "^10.0.10",
        "@types/mongoose": "^5.11.96",
        "@types/multer": "^1.4.12",
        "@types/supertest": "^7.2.1",
        "mocha": "^10.7.3",
        "nodemon": "^3.1.14",
        "supertest": "^7.2.2"
    }
}
